# StockValuation.io v1 uses Docker only.
# Copy this file to .env, keep real values out of source control, and run:
#   ./scripts/bootstrap_local_secrets.sh

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=stockvaluation_io

YFINANCE_SECRET_KEY=CHANGE_ME
VALUATION_SERVICE_JWT_SECRET=CHANGE_ME_32_PLUS_CHARS

CURRENCY_PROVIDER_BASE_URL=https://api.frankfurter.dev/v2

DEFAULT_USERNAME=local_admin
DEFAULT_PASSWORD=CHANGE_ME
DEFAULT_FIRSTNAME=Local
DEFAULT_LASTNAME=Admin
DEFAULT_CONTACT=0000000000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL=false
